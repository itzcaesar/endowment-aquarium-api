NODE_ENV=development
LOG_LEVEL=debug

GAME_API_PORT=3000
MOCK_API_PORT=4000

# Use the hosted Supabase PostgreSQL connection string from the Connect panel.
# SSL is enabled automatically for non-local hosts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/endowment_aquarium
# Integration/e2e tests require an isolated database and never fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/endowment_aquarium_test

ENDOWMENT_WEBHOOK_SECRET=replace-me-with-at-least-16-characters
GAME_API_WEBHOOK_URL=http://localhost:3000/webhooks/v1/endowment
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Server-to-server donor lookup (GET {ENDOWMENT_API_BASE_URL}/api/v1/donors/:nik).
# Point at the mock API locally; swap to the real Endowment URL + ticket in production.
ENDOWMENT_API_BASE_URL=http://localhost:4000
ENDOWMENT_API_TICKET=replace-me-with-the-endowment-ticket
ENDOWMENT_API_TIMEOUT_MS=5000

# Optional: enables the operations dashboard at /dashboard (min 32 chars). Leave unset to disable.
ADMIN_DASHBOARD_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

